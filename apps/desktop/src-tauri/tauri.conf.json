{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jade",
  "version": "0.2.8",
  "identifier": "app.jade.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node ../../scripts/prepare-bundle-cli.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jade",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0c0f0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/jade": "../../../target/release/jade"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/jade": "../../../target/release/jade"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDN0EyODQ1MEQzOTcwODMKUldTRGNEa05SU2g2VElTSXU1K3c1SVJpWjkxTytad0ZkcExlUzIvWVlUa0FkNkVpcHlwMzZ4aVQK",
      "endpoints": [
        "https://github.com/JoelYoung01/Jade/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
